module main

imports

  statixruntime
  statix/api
  injections/-
  signatures/start-sig
  pp
  completion

rules // Analysis

  pre-analyze  = origin-track-forced(explicate-injections-ql-Start)
  post-analyze = origin-track-forced(implicate-injections-ql-Start)

  editor-analyze = stx-editor-analyze(pre-analyze, post-analyze|"main", "programOk")
  editor-resolve = stx-editor-resolve
  editor-hover   = stx-editor-hover
