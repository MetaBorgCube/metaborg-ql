module mix

imports

  StrategoLang/import-namespaced
  StrategoLang/core/modules-namespaced
  StrategoLang/core/terms-namespaced
  ql
  types
  expressions
  lex

context-free start-symbols

  Module

context-free sorts

  Module

context-free syntax

  Module = StrategoLang-Module

  StrategoLang-PreTerm.StrategoToMetaExpr1 = <ql |[ <Start> ]|>
  StrategoLang-PreTerm.StrategoToMetaExpr2 = <ql |[ <TyExpr> ]|>
  StrategoLang-PreTerm.StrategoToMetaExpr3 = <ql |[ <Type> ]|>
  StrategoLang-PreTerm.StrategoToMetaExpr4 = <ql |[ <Expr> ]|>

context-free syntax

  Expr.StrategoMetaVar1 = ExprVar
  Label.StrategoMetaVar2 = LabelVar
  Type.StrategoMetaVar3 = TypeVar
  TyExpr.StrategoMetaVar4 = TyExprVar

syntax

  ID-CF.StrategoMetaVar5 = IDVar

lexical sorts

  IDVar ExprVar LabelVar TypeVar TyExprVar

lexical syntax

  IDVar = [fgq] "id" [0-9]*
  ExprVar = ("cond"|"expr"|"exp"|"e"|"c") [0-9]*
  LabelVar = ("label"|"text"|"l") [0-9]*
  TypeVar = ("type"|"t") [0-9]*
  TyExprVar = ("texpr"|"texp"|"te") [0-9]*

  ID = IDVar {reject}
  ID = ExprVar {reject}
