module mix

imports

  StrategoLang/import-namespaced
  StrategoLang/core/modules-namespaced
  StrategoLang/core/terms-namespaced
  ql
  types
  expressions
  lex

context-free start-symbols

  Module

context-free sorts

  Module

context-free syntax

  Module = StrategoLang-Module

  StrategoLang-PreTerm.ToMetaExpr = [[ql |[ Form ]|]]
  StrategoLang-PreTerm.ToMetaExpr = [[ql |[ TyExpr ]|]]
  StrategoLang-PreTerm.ToMetaExpr = [[ql |[ Type ]|]]
  StrategoLang-PreTerm.ToMetaExpr = [[ql |[ Expr ]|]]

context-free syntax

  Expr.meta-var = ExprVar
  Label.meta-var = LabelVar
  Type.meta-var = TypeVar
  TyExpr.meta-var = TyExprVar

syntax

  ID-CF.meta-var = IDVar

lexical sorts

  IDVar ExprVar LabelVar TypeVar TyExprVar

lexical syntax

  IDVar = [fgq] "id" [0-9]*
  ExprVar = ("cond"|"expr"|"exp"|"e"|"c") [0-9]*
  LabelVar = ("label"|"text"|"l") [0-9]*
  TypeVar = ("type"|"t") [0-9]*
  TyExprVar = ("texpr"|"texp"|"te") [0-9]*

  ID = IDVar {reject}
  ID = ExprVar {reject}
