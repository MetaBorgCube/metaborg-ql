  implicate-injections-ql-Expr =
    origin-track-forced(
      \ Expr-Plhdr(){anno*} -> Expr-Plhdr(){anno*} \
    )

  implicate-injections-ql-NumLit =
    origin-track-forced(
      \ NumLit-Plhdr(){anno*} -> NumLit-Plhdr(){anno*} \
    )

  implicate-injections-ql-Expr =
    origin-track-forced(
      \ "nabl2.Var"#([resource, name]){anno*} -> "nabl2.Var"#([resource, name]){anno*} \
