  upgrade-placeholders-ql-Expr =
    origin-track-forced(
      \ Geq(expr1, expr2){anno*} -> Geq(expr1', expr2'){anno*}
        with expr1' := <upgrade-placeholders-ql-Expr> expr1
             ; expr2' := <upgrade-placeholders-ql-Expr> expr2 \
    )

  upgrade-placeholders-ql-Expr =
    origin-track-forced(
      \ Eq(expr1, expr2){anno*} -> Eq(expr1', expr2'){anno*}
