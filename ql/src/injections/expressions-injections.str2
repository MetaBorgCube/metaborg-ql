        with expr1' := <implicate-injections-ql-Expr> expr1
             ; expr2' := <implicate-injections-ql-Expr> expr2 \
    )

  implicate-injections-ql-Expr =
    origin-track-forced(
      \ Geq(expr1, expr2){anno*} -> Geq(expr1', expr2'){anno*}
        with expr1' := <implicate-injections-ql-Expr> expr1
             ; expr2' := <implicate-injections-ql-Expr> expr2 \
    )

  implicate-injections-ql-Expr =
    origin-track-forced(
      \ Eq(expr1, expr2){anno*} -> Eq(expr1', expr2'){anno*}
        with expr1' := <implicate-injections-ql-Expr> expr1
