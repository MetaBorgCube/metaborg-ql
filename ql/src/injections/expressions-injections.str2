  upgrade-placeholders-ql-NumLit =
    origin-track-forced(
      \ FloatLit(float){anno*} -> FloatLit(float'){anno*}
        with float' := <upgrade-placeholders-ql-FLOAT> float \
    )

  upgrade-placeholders-ql-Expr =
    origin-track-forced(
      \ numLit -> <upgrade-placeholders-ql-NumLit> numLit
        where <is-ql-NumLit-or-inj> numLit \
    )

  upgrade-placeholders-ql-Expr =
    origin-track-forced(
      \ NumLit2Expr(numLit){anno*} -> NumLit2Expr(<upgrade-placeholders-ql-NumLit> numLit){anno*} \
    )

  upgrade-placeholders-ql-Expr =
    origin-track-forced(
      \ MoneyLit(numLit){anno*} -> MoneyLit(numLit'){anno*}
        with numLit' := <upgrade-placeholders-ql-NumLit> numLit \
    )

  upgrade-placeholders-ql-Expr =
    origin-track-forced(
      \ Expr-Plhdr(){anno*} -> p{anno*}
        with p := <make-placeholder> "Expr" \
    )

  upgrade-placeholders-ql-NumLit =
    origin-track-forced(
      \ NumLit-Plhdr(){anno*} -> p{anno*}
        with p := <make-placeholder> "NumLit" \
    )

  upgrade-placeholders-ql-Expr =
    origin-track-forced(
      \ "nabl2.Var"#([resource, name]){anno*} -> "nabl2.Var"#([resource, name]){anno*} \
