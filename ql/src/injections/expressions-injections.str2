  upgrade-placeholders-ql-NumLit =
    origin-track-forced(
      \ "nabl2.Var"#([resource, name]){anno*} -> "nabl2.Var"#([resource, name]){anno*} \
    )

  upgrade-placeholders-ql-Expr =
    origin-track-forced(
      \ amb(alts){anno*} -> amb(alts'){anno*}
        with alts' := <upgrade-list(upgrade-placeholders-ql-Expr)> alts \
    )

  upgrade-placeholders-ql-NumLit =
    origin-track-forced(
      \ amb(alts){anno*} -> amb(alts'){anno*}
        with alts' := <upgrade-list(upgrade-placeholders-ql-NumLit)> alts \
    )


